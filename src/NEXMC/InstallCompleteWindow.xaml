<ui:FluentWindow x:Class="NEXMC.InstallCompleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Title="NEXMC · 安装结果" Width="590" SizeToContent="Height"
        MinHeight="280" MaxHeight="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}" ResizeMode="NoResize">
    <Grid Margin="26">
        <Border Style="{StaticResource Card}" Padding="24">
            <StackPanel>
                <Border Width="48" Height="6" CornerRadius="3" Background="{StaticResource BrandGradient}" HorizontalAlignment="Left"/>
                <TextBlock Text="安装结果" FontSize="24" FontWeight="SemiBold" Margin="0,15,0,7"/>
                <TextBlock x:Name="SummaryText" Style="{StaticResource MutedText}" FontSize="13"/>
                <ItemsControl x:Name="SuccessItemsControl" Margin="0,18,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                    <TextBlock Text="{Binding Directory}" Style="{StaticResource MutedText}" Margin="0,5,0,11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="打开安装目录" Style="{StaticResource SecondaryButton}" MinHeight="34" Padding="12,5" Tag="{Binding}" Click="OpenDirectory_Click" Margin="0,0,8,0"/>
                                        <Button Content="打开启动器" Style="{StaticResource GhostButton}" MinHeight="34" Padding="12,5" Tag="{Binding}" Click="OpenLauncher_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="完成" Width="96" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="Close_Click" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
