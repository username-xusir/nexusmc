<ui:FluentWindow x:Class="NEXMC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:NEXMC.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Title="nexus mc · Minecraft 下载器"
        Width="1180" Height="820" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Icon="pack://application:,,,/assets/nexmc.ico"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandGradient}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton x:Name="GameNav" GroupName="MainNavigation" Style="{StaticResource TopNavigationButton}" IsChecked="True" Tag="Game" Checked="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,7,0"/>
                            <TextBlock Text="游戏下载" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ModpackNav" GroupName="MainNavigation" Style="{StaticResource TopNavigationButton}" Tag="Modpack" Checked="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,7,0"/>
                            <TextBlock Text="整合包" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TasksNav" GroupName="MainNavigation" Style="{StaticResource TopNavigationButton}" Tag="Tasks" Checked="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,7,0"/>
                            <TextBlock Text="下载任务" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SettingsNav" GroupName="MainNavigation" Style="{StaticResource TopNavigationButton}" Tag="Settings" Checked="Navigation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,7,0"/>
                            <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,6,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <ComboBox x:Name="LauncherTargetComboBox" Width="274" Height="48" MinHeight="48" SelectionChanged="InstallInput_Changed" ToolTip="自动识别或手动添加的启动器名称与已安装版本数量">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,2" ToolTip="{Binding Directory}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="RefreshLaunchersButton" Width="34" Height="34" MinHeight="34" Padding="0" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" Click="RefreshLaunchers_Click" ToolTip="重新扫描启动器">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource BlueBrush}"/>
                    </Button>
                    <Button x:Name="AddLauncherButton" Width="34" Height="34" MinHeight="34" Padding="0" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" Click="AddLauncher_Click" ToolTip="添加新的启动器" AutomationProperties.Name="添加启动器">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource BlueBrush}"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,10,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Image Source="pack://application:,,,/assets/badge-white.png" Height="32" Width="32" Stretch="Uniform" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="nexus mc" Foreground="White" FontFamily="Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                        <Border Background="#22FFFFFF" CornerRadius="5" Padding="6,1" HorizontalAlignment="Left" Margin="0,3,0,0">
                            <TextBlock x:Name="BrandVersionText" Text="v1.0.9" Foreground="#E8E8E8" FontSize="9" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="10"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="最大化" AutomationProperties.Name="最大化">
                        <TextBlock x:Name="MaximizeGlyphText" Text="&#xE922;" FontFamily="Segoe Fluent Icons" FontSize="10"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="CloseWindow_Click" ToolTip="关闭" AutomationProperties.Name="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ErrorBanner" Grid.Row="1" Background="#1B1B1B" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <DockPanel Margin="18,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="ErrorOpenBbsmcButton" Content="打开 BBSMC 验证" Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="10,4" Margin="0,0,6,0" Visibility="Collapsed" Click="ErrorOpenBbsmc_Click" AutomationProperties.Name="打开BBSMC验证"/>
                    <Button x:Name="ErrorChooseLocalButton" Content="选择本地整合包" Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="10,4" Margin="0,0,6,0" Visibility="Collapsed" Click="ErrorChooseLocal_Click" AutomationProperties.Name="选择本地整合包"/>
                    <Button Style="{StaticResource CaptionButton}" Width="30" Height="26" Click="CloseErrorBanner_Click" ToolTip="关闭错误提示" AutomationProperties.Name="关闭错误提示">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10"/>
                    </Button>
                </StackPanel>
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="White" VerticalAlignment="Top" Margin="0,4,10,0"/>
                <TextBlock x:Name="ErrorBannerText" Foreground="White" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
                <!-- 游戏下载 -->
                <ScrollViewer x:Name="GamePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,18,20,20">
                        <TextBlock Text="游戏下载" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="从真实版本源选择 Minecraft，再按需安装模组加载器。" Style="{StaticResource MutedText}" FontSize="13" Margin="0,7,0,21"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,18">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="版本分类" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="VersionCategoryComboBox" Width="150" SelectionChanged="VersionCategory_Changed" SelectedIndex="1">
                                            <ComboBoxItem Content="全部版本" Tag="全部版本"/>
                                            <ComboBoxItem Content="正式版本" Tag="正式版本"/>
                                            <ComboBoxItem Content="快照版本" Tag="快照版本"/>
                                            <ComboBoxItem Content="愚人节版本" Tag="愚人节版本"/>
                                            <ComboBoxItem Content="古早版本" Tag="古早版本"/>
                                        </ComboBox>
                                        <Button x:Name="RefreshVersionsButton" Content="刷新版本" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="RefreshVersions_Click"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="版本与加载器" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="按正式版、快照、愚人节与古早版本分类筛选" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="230"/>
                                        <ColumnDefinition Width="*" MinWidth="150"/>
                                        <ColumnDefinition Width="*" MinWidth="150"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock Text="Minecraft 版本" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="MinecraftVersionComboBox" SelectionChanged="MinecraftVersion_Changed">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold" Margin="0,0,10,0" TextWrapping="NoWrap"/>
                                                        <TextBlock Text="{Binding Type}" Foreground="{StaticResource BlueBrush}" Margin="0,0,10,0" TextWrapping="NoWrap"/>
                                                        <TextBlock Text="{Binding ReleaseTime}" Style="{StaticResource MutedText}" TextWrapping="NoWrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                        <TextBlock Text="加载器" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="LoaderKindComboBox" SelectionChanged="LoaderKind_Changed" SelectedIndex="0">
                                            <ComboBoxItem Content="无（原版）" Tag=""/>
                                            <ComboBoxItem Content="Fabric" Tag="Fabric"/>
                                            <ComboBoxItem Content="Forge" Tag="Forge"/>
                                            <ComboBoxItem Content="NeoForge" Tag="NeoForge"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="加载器版本" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="LoaderVersionComboBox" DisplayMemberPath="Version" IsEnabled="False" SelectionChanged="InstallInput_Changed"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="VersionStateText" Text="尚未加载版本，点击“刷新版本”获取真实列表。" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="创建安装实例" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="实例名称会用于启动器中的版本目录。" Style="{StaticResource MutedText}" Margin="0,5,0,16"/>
                                    <StackPanel>
                                        <TextBlock Text="实例名称" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="GameInstanceNameTextBox" MaxLength="120" TextChanged="InstallInput_Changed"/>
                                        <TextBlock x:Name="GameNameValidationText" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                                        <TextBlock Text="安装目标由窗口顶部下拉菜单选择；下载方式（安装/仅下载到本地）在设置页切换" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Width="188" VerticalAlignment="Bottom">
                                    <Button x:Name="GameInstallButton" Content="开始安装" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="GameInstall_Click"/>
                                    <TextBlock Text="安装期间可在下载任务中取消" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 整合包 -->
                <Grid x:Name="ModpackPage" Visibility="Collapsed" Margin="20,16,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,17">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LocalModpackPathText" Text="本地包：未选择" Style="{StaticResource MutedText}" MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="BrowseLocalModpackButton" Content="从本地安装" Style="{StaticResource SecondaryButton}" Click="BrowseLocalModpack_Click"/>
                            <Button x:Name="ClearLocalModpackButton" Content="清除" Style="{StaticResource GhostButton}" IsEnabled="False" Margin="7,0,0,0" Click="ClearLocalModpack_Click"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="整合包" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="先浏览全部整合包；点开一个项目进入独立版本页，选择版本后再下载并命名。" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid x:Name="ModpackListView" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="160"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="200"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="搜索关键词" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ModpackSearchTextBox" KeyDown="ModpackSearch_KeyDown" ToolTip="输入整合包名称、作者或关键词；留空可浏览分类"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="来源（可多选）" Style="{StaticResource FieldLabel}"/>
                                    <Button x:Name="ModpackSourceButton" Content="全部来源" Style="{StaticResource SecondaryButton}" Click="ModpackSourceButton_Click"/>
                                    <Popup x:Name="ModpackSourcePopup"
                                           PlacementTarget="{Binding ElementName=ModpackSourceButton}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="14" Margin="0,6,0,0" Width="220">
                                            <StackPanel>
                                                <TextBlock Text="下载来源（可多选）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <CheckBox x:Name="SourceBbsmcCheckBox" Content="BBSMC" Tag="BBSMC" IsChecked="True"
                                                          Checked="ModpackSourceCheck_Changed" Unchecked="ModpackSourceCheck_Changed" Margin="0,4"/>
                                                <CheckBox x:Name="SourceModrinthCheckBox" Content="Modrinth" Tag="Modrinth" IsChecked="True"
                                                          Checked="ModpackSourceCheck_Changed" Unchecked="ModpackSourceCheck_Changed" Margin="0,4"/>
                                                <CheckBox x:Name="SourceCurseForgeCheckBox" Content="CurseForge" Tag="CurseForge" IsChecked="True"
                                                          Checked="ModpackSourceCheck_Changed" Unchecked="ModpackSourceCheck_Changed" Margin="0,4"/>
                                                <Separator Margin="0,6" Background="{StaticResource BorderBrush}"/>
                                                <DockPanel>
                                                    <Button x:Name="ModpackSourceDoneButton" DockPanel.Dock="Right" Content="完成" Width="70" Style="{StaticResource SecondaryButton}" Click="ModpackSourceDone_Click"/>
                                                    <Button x:Name="ModpackSourceSelectAllButton" Content="全选" Width="70" Style="{StaticResource GhostButton}" Click="ModpackSourceSelectAll_Click"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                    <TextBlock Text="分类" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="ModpackCategoryComboBox" SelectedIndex="0" SelectionChanged="ModpackCategory_Changed">
                                        <ComboBoxItem Content="全部分类" Tag=""/>
                                        <ComboBoxItem Content="冒险" Tag="冒险"/>
                                        <ComboBoxItem Content="科技" Tag="科技"/>
                                        <ComboBoxItem Content="魔法" Tag="魔法"/>
                                        <ComboBoxItem Content="优化" Tag="优化"/>
                                        <ComboBoxItem Content="战斗" Tag="战斗"/>
                                        <ComboBoxItem Content="任务" Tag="任务"/>
                                        <ComboBoxItem Content="多人" Tag="多人"/>
                                        <ComboBoxItem Content="硬核" Tag="硬核"/>
                                        <ComboBoxItem Content="轻量" Tag="轻量"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                                    <TextBlock Text="游戏版本（可选）" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ModpackGameVersionTextBox"/>
                                </StackPanel>
                                <Button x:Name="SearchModpacksButton" Grid.Column="4" Content="搜索" Width="86" Style="{StaticResource PrimaryButton}" Click="SearchModpacks_Click" VerticalAlignment="Bottom"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap">
                                    进入页面会自动加载全部整合包；来源可多选，取消勾选 BBSMC 就只查 Modrinth 和 CurseForge。BBSMC 部分文件由 CDN 人机验证保护，NEXMC 不绕过验证。
                                    <Hyperlink Click="OpenBbsmc_Click" Foreground="{StaticResource BlueBrush}">打开 BBSMC</Hyperlink>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="3,0,3,12">
                                    <TextBlock x:Name="ModpackSearchStateText" DockPanel.Dock="Right" Text="正在加载全部整合包…" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBlock Text="全部整合包" Style="{StaticResource SectionTitle}"/>
                                </DockPanel>
                                <Grid Grid.Row="1">
                                    <ListBox x:Name="ModpackProjectsList" SelectionChanged="ModpackProject_Changed"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="58">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="54" Height="54" CornerRadius="9" Background="#EFEFEF" Margin="0,0,13,0" ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initial}" FontSize="21" FontWeight="Bold" Foreground="#9A9A9A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <controls:ModpackIcon IconUrl="{Binding IconUrl}"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <DockPanel Margin="0,0,0,4">
                                                            <Border DockPanel.Dock="Right" Background="{StaticResource SoftBlueBrush}" CornerRadius="6" Padding="7,2" Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding Source}" Foreground="{StaticResource BlueBrush}" FontSize="9"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Downloads, StringFormat='下载量 {0:N0}'}" Style="{StaticResource MutedText}" FontSize="10" Margin="10,0,0,0"/>
                                                            <TextBlock Text="{Binding TagSummary}" Style="{StaticResource MutedText}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="查看版本 →" Style="{StaticResource MutedText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,2,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="ModpackProjectsEmptyText" Text="正在加载全部整合包…" Style="{StaticResource MutedText}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"/>
                                </Grid>
                                <Button x:Name="LoadMoreModpacksButton" Grid.Row="2" Content="加载更多" Style="{StaticResource GhostButton}" Height="32" Margin="3,10,3,0" Visibility="Collapsed" Click="LoadMoreModpacks_Click"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="ModpackVersionView" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="120"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BackToModpackListButton" Content="← 返回整合包列表" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Click="BackToModpackList_Click" Margin="0,0,16,0"/>
                                <Grid Grid.Column="1" Margin="0,0,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="88" Height="88" CornerRadius="12" Background="#EFEFEF" ClipToBounds="True" VerticalAlignment="Top">
                                        <Grid>
                                            <TextBlock Text="N" FontSize="28" FontWeight="Bold" Foreground="#9A9A9A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <controls:ModpackIcon IconUrl="{Binding SelectedItem.IconUrl, ElementName=ModpackProjectsList}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                                        <TextBlock x:Name="SelectedModpackNameText" Text="选择一个整合包" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding SelectedItem.SourceAndDownloads, ElementName=ModpackProjectsList}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding SelectedItem.Description, ElementName=ModpackProjectsList}" Style="{StaticResource MutedText}" MaxHeight="48" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
                                        <ItemsControl ItemsSource="{Binding SelectedItem.Tags, ElementName=ModpackProjectsList}" Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F0F0F0" CornerRadius="5" Padding="7,2" Margin="0,0,5,4">
                                                        <TextBlock Text="{Binding}" FontSize="10" Foreground="#555555"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="SelectModpackVersionsButton" Content="重新加载版本" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="SelectModpackVersions_Click"/>
                                    <Button x:Name="OpenModpackPageButton" Content="打开介绍页" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="8,0,0,0" Click="OpenModpackPage_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock x:Name="ModpackVersionsStateText" DockPanel.Dock="Right" Text="" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBlock Text="版本管理" Style="{StaticResource SectionTitle}"/>
                                </DockPanel>
                                <Grid Grid.Row="1">
                                    <ListBox x:Name="ModpackVersionsList" SelectionChanged="InstallInput_Changed"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                    <DockPanel Margin="0,6,0,0">
                                                        <TextBlock DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding InstallModeText}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDirectDownload}" Value="True">
                                                                            <Setter Property="Text" Value="直链可用"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding GameVersion, StringFormat='Minecraft {0}'}" Style="{StaticResource MutedText}"/>
                                                    </DockPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="ModpackDetailHintText" Text="正在加载版本…" Style="{StaticResource MutedText}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ModpackVersionsEmptyText" Text="选择版本后显示在这里。" Style="{StaticResource MutedText}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="下载" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="ModpackSelectionSummaryText" Text="选择一个版本后下载。" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                    <TextBlock Text="直链版本会先让你命名实例；仅网盘版本会打开网盘链接，若没有网盘则打开项目介绍页。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"/>
                                    <StackPanel Visibility="Collapsed">
                                        <TextBox x:Name="ModpackInstanceNameTextBox" MaxLength="120" TextChanged="InstallInput_Changed"/>
                                        <TextBlock x:Name="ModpackNameValidationText" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ModpackInstallHintText" Text="安装到所选启动器" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <Button x:Name="ModpackInstallButton" Content="下载并安装" Width="150" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="ModpackInstall_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 下载任务 -->
                <Grid x:Name="TasksPage" Visibility="Collapsed" Margin="20,18,20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,20">
                        <Button x:Name="CancelAllTasksButton" DockPanel.Dock="Right" Content="取消进行中的任务" Style="{StaticResource DangerButton}" Click="CancelAllTasks_Click" IsEnabled="False" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="下载任务" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="可连续添加多个任务；每个目标独立显示进度与结果，内核按顺序执行，失败不会被记作成功。" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TaskItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,15">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                                                   Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   Visibility="{Binding IsAllSuccess, Converter={StaticResource BoolToVisibility}}"/>
                                                        <TextBlock Text="{Binding OverallStatus}" Foreground="{StaticResource BlueBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                        <Button Content="取消" Style="{StaticResource DangerButton}" MinHeight="32" Padding="12,4" IsEnabled="{Binding CanCancel}" Tag="{Binding}" Click="CancelTask_Click"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding StartedAtText, StringFormat='开始于 {0}'}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Targets}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#FAFAFA" BorderBrush="#E4E4E4" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,9">
                                                                <StackPanel>
                                                                    <DockPanel Margin="0,0,0,9">
                                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                                                                       Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                                       Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVisibility}}"/>
                                                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold"/>
                                                                            <TextBlock Text="{Binding Directory}" Style="{StaticResource MutedText}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}"
                                                                                 Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}}"/>
                                                                    <DockPanel Margin="0,8,0,0">
                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource MutedText}" Margin="12,0,0,0"/>
                                                                        <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                                    </DockPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel x:Name="TasksEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource SoftBlueBrush}">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="还没有下载任务" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,7"/>
                            <TextBlock Text="从游戏下载或整合包页面发起真实安装。" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                                                <!-- 设置 -->
                                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="20,18,20,20">
                                        <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
                                        <TextBlock Text="目录与启动器路径仅保存在本机，不会自动创建游戏目录。" Style="{StaticResource MutedText}" FontSize="13" Margin="0,7,0,21"/>

                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Button Content="添加启动器" Style="{StaticResource PrimaryButton}" MinHeight="32" Padding="13,5" Click="AddLauncher_Click"/>
                                                        <Button x:Name="OpenSelectedLauncherButton" Content="打开所选" Style="{StaticResource SecondaryButton}" MinHeight="32" Padding="11,5" Margin="7,0,0,0" IsEnabled="False" Click="OpenSelectedLauncher_Click"/>
                                                        <Button x:Name="RemoveLauncherButton" Content="移除所选" Style="{StaticResource GhostButton}" MinHeight="32" Padding="11,5" Margin="7,0,0,0" IsEnabled="False" Click="RemoveLauncher_Click"/>
                                                        <Button Content="重新扫描" Style="{StaticResource GhostButton}" MinHeight="32" Padding="11,5" Margin="7,0,0,0" Click="RefreshLaunchers_Click"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,18,0">
                                                        <TextBlock Text="启动器" Style="{StaticResource SectionTitle}"/>
                                                        <TextBlock Text="自动检测 PCL、HMCL、Prism、官方启动器等已知程序；其他标准 .minecraft 目录请点“添加启动器”。" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <Grid Margin="0,16,0,0" VerticalAlignment="Top">
                                                    <ListBox x:Name="CustomLauncherList" MaxHeight="120" VerticalAlignment="Top" SelectionChanged="CustomLauncherList_SelectionChanged">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                                        <TextBlock Text="{Binding Directory}" Style="{StaticResource MutedText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                                        <TextBlock Text="{Binding ExecutablePath}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                                    </StackPanel>
                                                                    <Border Grid.Column="1" Background="#F0F0F0" CornerRadius="5" Padding="7,2" VerticalAlignment="Top">
                                                                        <TextBlock Text="手动添加" FontSize="9" Foreground="#555555"/>
                                                                    </Border>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <TextBlock x:Name="CustomLauncherEmptyText" Text="还没有手动添加的启动器。自动检测结果会直接出现在顶部下拉框。" Style="{StaticResource MutedText}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,10" IsHitTestVisible="False"/>
                                                </Grid>

                                                <TextBlock Text="添加的目录兼容 PCL2、HMCL、Prism、官方启动器或其他标准 .minecraft 结构；NEXMC 只写入 versions，不修改启动器本体。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0"/>
                                                <TextBlock x:Name="LauncherSettingsStateText" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                            <DockPanel>
                                                <Button x:Name="OpenHallOfFameButton" DockPanel.Dock="Right" Content="进入名人堂" Width="126" Style="{StaticResource SecondaryButton}"
                                                        Click="OpenHallOfFame_Click" VerticalAlignment="Center" AutomationProperties.Name="进入名人堂"/>
                                                <StackPanel Margin="0,0,20,0">
                                                    <TextBlock Text="名人堂" Style="{StaticResource SectionTitle}"/>
                                                    <TextBlock Text="鸣谢提供 PCL2 下载内核的龙腾猫跃、NEXMC 开发者和内测人员。" Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                        <Border Width="34" Height="34" CornerRadius="17" ClipToBounds="True" Background="#EFEFEF" Margin="0,0,8,0">
                                                            <Image Source="pack://application:,,,/assets/hall/huogoooo.png" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <Border Width="34" Height="34" CornerRadius="17" ClipToBounds="True" Background="#EFEFEF" Margin="0,0,8,0">
                                                            <Image Source="pack://application:,,,/assets/hall/longtengmaoyue.png" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <Border Width="34" Height="34" CornerRadius="17" ClipToBounds="True" Background="#EFEFEF">
                                                            <Image Source="pack://application:,,,/assets/hall/username-xusir.png" Stretch="UniformToFill"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                            <StackPanel>
                                                <TextBlock Text="下载方式" Style="{StaticResource SectionTitle}"/>
                                                <TextBlock Text="安装到启动器，或仅把文件下载到本地文件夹。游戏下载和整合包下载共用这个选择。" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                                                <Grid Margin="0,14,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="240"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="DownloadModeComboBox" SelectionChanged="DownloadMode_Changed">
                                                        <ComboBoxItem Content="安装到启动器" Tag="install"/>
                                                        <ComboBoxItem Content="仅下载到本地（不写入启动器）" Tag="local"/>
                                                    </ComboBox>
                                                    <Grid Grid.Column="1" Margin="12,0,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="LocalDownloadDirectoryTextBox" IsEnabled="False" TextChanged="LocalDownloadDirectory_Changed" ToolTip="仅下载模式下保存整合包和原版文件的文件夹"/>
                                                        <Button x:Name="BrowseLocalDownloadButton" Grid.Column="1" Content="浏览…" Width="82" Style="{StaticResource GhostButton}" Margin="9,0,0,0" IsEnabled="False" Click="BrowseLocalDownload_Click"/>
                                                    </Grid>
                                                </Grid>
                                                <TextBlock Text="仅下载模式：整合包保存为 .mrpack/.zip；原版下载为本地可携带的 .minecraft 目录，不写入 PCL/HMCL。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button x:Name="SaveSettingsButton" DockPanel.Dock="Right" Content="保存设置" Width="126" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click" VerticalAlignment="Top"/>
                                                    <StackPanel Margin="0,0,20,0">
                                                        <TextBlock Text="下载设置" Style="{StaticResource SectionTitle}"/>
                                                        <TextBlock Text="默认线路失败时由 PCL 内核切换其他线路；以下设置保存到本机。" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <Grid Margin="0,18,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,18,14">
                                                        <TextBlock Text="游戏下载线路" Style="{StaticResource FieldLabel}"/>
                                                        <ComboBox x:Name="GameDownloadSourceComboBox">
                                                            <ComboBoxItem Content="自动（优先官方，失败切换镜像）" Tag="auto"/>
                                                            <ComboBoxItem Content="官方源优先（Mojang，失败切换 BMCLAPI）" Tag="official"/>
                                                            <ComboBoxItem Content="镜像优先（BMCLAPI，老版本更快；新版本可能缺资源）" Tag="mirror"/>
                                                        </ComboBox>
                                                        <TextBlock Text="新版本资源优先走官方；BMCLAPI 仅作回退，避免镜像缺少新资源时卡住。" Style="{StaticResource MutedText}" FontSize="10" Margin="0,5,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                                                        <TextBlock Text="默认整合包来源" Style="{StaticResource FieldLabel}"/>
                                                        <ComboBox x:Name="DefaultModpackSourceComboBox">
                                                            <ComboBoxItem Content="全部来源（BBSMC + Modrinth + CurseForge）" Tag="全部来源"/>
                                                            <ComboBoxItem Content="BBSMC" Tag="BBSMC"/>
                                                            <ComboBoxItem Content="Modrinth" Tag="Modrinth"/>
                                                            <ComboBoxItem Content="CurseForge（MCIMirror）" Tag="CurseForge"/>
                                                        </ComboBox>
                                                        <CheckBox x:Name="FallbackModpackCheckBox" Content="主来源失败时自动查询其他整合包来源" Margin="0,8,0,0" IsChecked="True"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,18,14">
                                                        <TextBlock Text="下载线程数" Style="{StaticResource FieldLabel}"/>
                                                        <ComboBox x:Name="DownloadThreadsComboBox">
                                                            <ComboBoxItem Content="8 线程" Tag="8"/>
                                                            <ComboBoxItem Content="16 线程" Tag="16"/>
                                                            <ComboBoxItem Content="32 线程" Tag="32"/>
                                                            <ComboBoxItem Content="64 线程" Tag="64"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                                                        <TextBlock Text="下载限速" Style="{StaticResource FieldLabel}"/>
                                                        <ComboBox x:Name="DownloadSpeedComboBox">
                                                            <ComboBoxItem Content="不限速" Tag="0"/>
                                                            <ComboBoxItem Content="5 MB/s" Tag="5"/>
                                                            <ComboBoxItem Content="10 MB/s" Tag="10"/>
                                                            <ComboBoxItem Content="20 MB/s" Tag="20"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,18,14">
                                                        <TextBlock Text="失败重试次数" Style="{StaticResource FieldLabel}"/>
                                                        <ComboBox x:Name="RetryAttemptsComboBox">
                                                            <ComboBoxItem Content="1 次（不重试）" Tag="1"/>
                                                            <ComboBoxItem Content="2 次" Tag="2"/>
                                                            <ComboBoxItem Content="3 次（默认）" Tag="3"/>
                                                            <ComboBoxItem Content="4 次" Tag="4"/>
                                                            <ComboBoxItem Content="5 次" Tag="5"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,14">
                                                        <TextBlock Text="每次重试间隔" Style="{StaticResource FieldLabel}"/>
                                                        <ComboBox x:Name="RetryDelayComboBox">
                                                            <ComboBoxItem Content="5 秒" Tag="5"/>
                                                            <ComboBoxItem Content="10 秒（默认）" Tag="10"/>
                                                            <ComboBoxItem Content="15 秒" Tag="15"/>
                                                            <ComboBoxItem Content="30 秒" Tag="30"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                                                        <TextBlock Text="下载缓存与日志" Style="{StaticResource FieldLabel}"/>
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                <Button Content="打开数据目录" Style="{StaticResource GhostButton}" MinHeight="30" Padding="11,4" Click="OpenDataDirectory_Click"/>
                                                                <Button Content="打开日志" Style="{StaticResource GhostButton}" MinHeight="30" Padding="11,4" Margin="7,0,0,0" Click="OpenLog_Click"/>
                                                            </StackPanel>
                                                            <TextBlock Text="安装失败会写入 errors.log；重试会复用已下载的缓存文件。" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="SettingsStateText" Style="{StaticResource MutedText}" Margin="2,12,2,0"/>
                                    </StackPanel>
                                </ScrollViewer>
            </Grid>

            <Border x:Name="StatusBorder" Grid.Row="3" Background="#F2F2F2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel Margin="16,0">
                    <TextBlock x:Name="FooterVersionText" DockPanel.Dock="Right" Text="NEXMC 1.0.9 · Fluent 2" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock x:Name="LauncherTargetStateText" DockPanel.Dock="Right" Text="正在扫描启动器…" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" MaxWidth="400" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="16,0,0,0"/>
                    <TextBlock x:Name="StatusText" Text="正在准备界面…" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
</ui:FluentWindow>
