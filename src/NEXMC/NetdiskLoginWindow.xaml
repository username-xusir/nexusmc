<ui:FluentWindow x:Class="NEXMC.NetdiskLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        FontFamily="{StaticResource AppFont}"
        Title="登录网盘 · NEXMC"
        Width="1000" Height="780" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Icon="pack://application:,,,/assets/nexmc.ico"
        Loaded="Window_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="登录网盘" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="登录只用于读取你自己的分享直链，Cookie 使用 Windows DPAPI 加密保存在本机。"/>
                </StackPanel>
                <Border Grid.Column="1" Width="48" Height="48" CornerRadius="14" Background="#111111">
                    <TextBlock Text="N" Foreground="White" FontSize="26" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <wv2:WebView2 x:Name="Browser"/>
                <Border x:Name="ManualPanel" Visibility="Collapsed" Background="#171717" Padding="28">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="内置浏览器不可用" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,8,0,16"
                                   Text="请先用系统浏览器登录网盘，再从浏览器开发者工具复制 Cookie，粘贴到下面。"/>
                        <TextBox x:Name="ManualCookieBox" Height="120" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 ToolTip="需要包含 __pus= 和 __puus= 两项。"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="正在打开网盘登录页…" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HintText" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Text="登录完成后点击右侧按钮读取 Cookie。NEXMC 不会保存你的账号密码。"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="取消" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="Cancel_Click"/>
                    <Button x:Name="ReadCookieButton" AutomationProperties.AutomationId="ReadCookieButton" Content="我已登录，读取 Cookie" Style="{StaticResource PrimaryButton}"
                            Click="ReadCookie_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
