<Window x:Class="NEXMC.BbsmcCaptchaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="BBSMC 人机验证 · NEXMC"
        Width="1050" Height="780" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource BrandGradient}" Padding="18,12">
            <StackPanel>
                <TextBlock Text="BBSMC 人机验证" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="请在下方页面完成验证并点击页面上的下载按钮。NEXMC 不会读取浏览器 Cookie，也不会绕过验证。"
                           Foreground="#D0D0D0" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="14,12,14,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <wv2:WebView2 x:Name="Browser"/>
        </Border>

        <Border Grid.Row="2" Background="#F2F2F2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                           Text="正在加载 BBSMC 页面…" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="重新加载" Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="11,4" Margin="0,0,7,0" Click="Reload_Click"/>
                    <Button Content="外部浏览器打开" Style="{StaticResource SecondaryButton}" MinHeight="30" Padding="11,4" Margin="0,0,7,0" Click="External_Click"/>
                    <Button Content="取消" Style="{StaticResource GhostButton}" MinHeight="30" Padding="11,4" Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
