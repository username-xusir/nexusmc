<ui:FluentWindow x:Class="NEXMC.InternalBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="内置浏览器 · NEXMC"
        Width="1040" Height="780" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{StaticResource PageBrush}"
        Icon="pack://application:,,,/assets/nexmc.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="刷新" Style="{StaticResource SecondaryButton}" MinHeight="32" Padding="12,4" Margin="0,0,8,0" Click="Reload_Click"/>
                    <Button Content="系统浏览器" Style="{StaticResource GhostButton}" MinHeight="32" Padding="12,4" Margin="0,0,8,0" Click="SystemBrowser_Click"/>
                    <Button Content="关闭" Style="{StaticResource GhostButton}" MinHeight="32" Padding="12,4" Click="Close_Click"/>
                </StackPanel>
                <TextBlock x:Name="AddressText" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Browser" Visibility="Collapsed"/>
            <WebBrowser x:Name="LegacyBrowser" Visibility="Collapsed"/>
        </Grid>

        <Border Grid.Row="2" Background="#F2F2F2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,7">
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Text="正在初始化内置浏览器…"/>
        </Border>
    </Grid>
</ui:FluentWindow>
