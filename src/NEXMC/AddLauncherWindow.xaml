<ui:FluentWindow x:Class="NEXMC.AddLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="添加启动器"
        Width="600" Height="590"
        ResizeMode="NoResize"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}"
        Icon="pack://application:,,,/assets/nexmc.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandGradient}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel Margin="18,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Click="Cancel_Click" ToolTip="关闭" AutomationProperties.Name="关闭"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10"/>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/assets/badge-white.png" Height="30" Width="30" Stretch="Uniform" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="添加启动器" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18,22,8">
                <TextBlock Text="把一个标准 .minecraft 目录加入安装目标" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="兼容 PCL、HMCL、Prism、官方启动器或其他使用 versions 目录的启动器。NEXMC 不修改启动器本体。" Style="{StaticResource MutedText}" Margin="0,6,0,18"/>

                <TextBlock Text="启动器名称" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameTextBox" MaxLength="80" ToolTip="用于顶部下拉框显示，不会写入启动器"/>

                <TextBlock Text="游戏目录（.minecraft，可选）" Style="{StaticResource FieldLabel}" Margin="0,14,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="DirectoryTextBox" Margin="0,0,9,0" ToolTip="包含 versions 子目录的标准 Minecraft 游戏目录"/>
                    <Button Grid.Column="1" Content="浏览…" Width="82" Style="{StaticResource GhostButton}" Click="BrowseDirectory_Click"/>
                </Grid>
                <TextBlock Text="不填时会根据启动器 EXE 自动寻找；目录可以暂时不存在，安装时按标准 .minecraft 结构创建。目录只保存在本机。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"/>

                <TextBlock Text="启动器 EXE（可选）" Style="{StaticResource FieldLabel}" Margin="0,14,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ExecutableTextBox" Margin="0,0,9,0" ToolTip="仅用于在安装完成后打开启动器"/>
                    <Button Grid.Column="1" Content="浏览…" Width="82" Style="{StaticResource GhostButton}" Click="BrowseExecutable_Click"/>
                </Grid>

                <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="0,14,0,0" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="取消" Width="88" Style="{StaticResource GhostButton}" Click="Cancel_Click" Margin="0,0,9,0"/>
                    <Button Content="添加" Width="96" Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
                </StackPanel>
                <TextBlock Text="添加后会自动重新扫描，并出现在顶部启动器下拉框。" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
