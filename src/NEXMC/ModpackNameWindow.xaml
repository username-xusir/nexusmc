<ui:FluentWindow x:Class="NEXMC.ModpackNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="命名整合包实例"
        Width="540" Height="360"
        ResizeMode="NoResize"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Icon="pack://application:,,,/assets/nexmc.ico"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandGradient}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel Margin="18,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Click="Cancel_Click" ToolTip="关闭" AutomationProperties.Name="关闭"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10"/>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/assets/badge-white.png" Height="30" Width="30" Stretch="Uniform" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="命名整合包实例" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,20,24,12">
            <TextBlock Text="给这次下载的整合包起一个名字" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="这个名字会出现在 PCL/HMCL 的版本列表里，也会作为 versions 目录名。" Style="{StaticResource MutedText}" Margin="0,7,0,18"/>
            <TextBlock Text="实例名称" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameTextBox" MaxLength="120" TextChanged="NameTextBox_TextChanged" ToolTip="不能包含路径字符，不能使用 Windows 保留名"/>
            <TextBlock x:Name="ValidationText" Style="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="取消" Width="88" Style="{StaticResource GhostButton}" Click="Cancel_Click" Margin="0,0,9,0"/>
                    <Button Content="下载并安装" Width="126" Style="{StaticResource PrimaryButton}" Click="Confirm_Click"/>
                </StackPanel>
                <TextBlock Text="下载前会再校验一次名称。" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
