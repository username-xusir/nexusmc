<ui:FluentWindow x:Class="NEXMC.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NEXMC 更新"
        Width="920" Height="680"
        MinWidth="760" MinHeight="580"
        ResizeMode="NoResize"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Icon="pack://application:,,,/assets/nexmc.ico"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="238"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandGradient}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel Margin="18,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="关闭" AutomationProperties.Name="关闭"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource SymbolFont}" FontSize="10"/>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/assets/logo-n-white.png" Width="46" Height="26" Stretch="Uniform" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="NEXMC 更新" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#080808" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" ClipToBounds="True">
            <Grid>
                <!-- 先铺黑到白的柔和过渡，图片的透明背景会让它自然透出来。 -->
                <Border VerticalAlignment="Bottom" Height="78" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#9AFFFFFF" Offset="0.58"/>
                            <GradientStop Color="#FFFFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <BlurEffect Radius="24"/>
                    </Border.Effect>
                </Border>
                <Image x:Name="BannerImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                <Grid x:Name="BannerFallback" Background="{StaticResource BrandGradient}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="NEXUS MC" Foreground="White" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FallbackVersionText" Foreground="#C9E9EA" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="28,18,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="NewVersionText" Text="发现新版本" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock x:Name="ReleaseTitleText" Style="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="更新内容" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <StackPanel x:Name="ReleaseNotesPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#F2F2F2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar x:Name="DownloadProgress" Height="5" Visibility="Collapsed" Margin="0,0,0,10" Minimum="0" Maximum="100"/>
                <DockPanel Grid.Row="1">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/assets/logo-n-black.png" Width="44" Height="26" Stretch="Uniform" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NEXUS MC" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="StatusText" Text="检测到可用更新。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="LaterButton" Content="稍后" Width="90" Style="{StaticResource GhostButton}" MinHeight="34" Margin="0,0,9,0" Click="Later_Click"/>
                        <Button x:Name="UpdateButton" Content="立即更新" Width="116" Style="{StaticResource PrimaryButton}" MinHeight="34" Click="Update_Click"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
