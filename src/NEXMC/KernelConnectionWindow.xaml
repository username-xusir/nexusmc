<ui:FluentWindow x:Class="NEXMC.KernelConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Title="NEXMC · 内核连接未完成" Width="680" Height="410"
        MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid Margin="34">
        <Border Style="{StaticResource Card}" Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border Width="52" Height="6" CornerRadius="3" Background="{StaticResource BrandGradient}" HorizontalAlignment="Left" Margin="0,0,0,18"/>
                    <TextBlock Text="内核连接未完成" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="NEXMC 已启动，但真实下载内核尚不可用。" Style="{StaticResource MutedText}" FontSize="13" Margin="0,8,0,16"/>
                </StackPanel>
                <Border Grid.Row="1" Background="#F6F8FB" CornerRadius="9" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="DetailsText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 TextWrapping="Wrap" VerticalContentAlignment="Top" FontSize="12"/>
                    </ScrollViewer>
                </Border>
                <DockPanel Grid.Row="2" Margin="0,18,0,0">
                    <TextBlock Text="不会加载演示数据或模拟安装结果。" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    <Button Content="关闭" Width="92" Style="{StaticResource PrimaryButton}" Click="Close_Click" HorizontalAlignment="Right"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
