<ui:FluentWindow x:Class="NEXMC.HallOfFameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="名人堂 · NEXMC"
        Width="820" Height="600"
        ResizeMode="NoResize"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Icon="pack://application:,,,/assets/nexmc.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandGradient}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel Margin="18,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="关闭" AutomationProperties.Name="关闭"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10"/>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/assets/badge-white.png" Height="30" Width="30" Stretch="Uniform" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="名人堂 · 鸣谢" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,22,26,10">
                <TextBlock Text="感谢让 NEXMC 成为可能的人" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="没有 PCL2 的下载内核、开发者的实现和测试人员的反复验证，就没有这个软件。" Style="{StaticResource MutedText}" Margin="0,7,0,22" TextWrapping="Wrap"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18" Margin="0,0,8,0">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="104" Height="104" CornerRadius="52" ClipToBounds="True" Background="#EFEFEF">
                                <Image Source="pack://application:,,,/assets/hall/huogoooo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock Text="huogoooo" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="nexus 内测人员" Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="感谢反复测试" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18" Margin="8,0" Cursor="Hand"
                            Tag="https://afdian.com/a/LTCat" MouseLeftButtonUp="Card_Click" ToolTip="打开爱发电：龙腾猫跃">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="104" Height="104" CornerRadius="52" ClipToBounds="True" Background="#EFEFEF">
                                <Image Source="pack://application:,,,/assets/hall/longtengmaoyue.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock Text="龙腾猫跃" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="伟大无需多言，提供了 PCL2 的下载内核" Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="爱发电 ↗" Foreground="{StaticResource BlueBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18" Margin="8,0,0,0" Cursor="Hand"
                            Tag="https://github.com/username-xusir" MouseLeftButtonUp="Card_Click" ToolTip="打开 GitHub：username-xusir">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="104" Height="104" CornerRadius="52" ClipToBounds="True" Background="#EFEFEF">
                                <Image Source="pack://application:,,,/assets/hall/username-xusir.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock Text="username-xusir" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="nexus mc 开发者" Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="GitHub ↗" Foreground="{StaticResource BlueBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="点击头像卡片会使用默认浏览器打开对应主页；huogoooo 暂未提供公开主页。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="关闭" Width="96" Style="{StaticResource PrimaryButton}" Click="Close_Click"/>
                <TextBlock Text="NEXMC 不会修改被鸣谢项目的名称、图标或版权信息。" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
