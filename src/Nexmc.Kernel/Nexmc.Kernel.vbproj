<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>Custom</MyType>
    <RootNamespace>PCL</RootNamespace>
    <AssemblyName>Nexmc.Kernel</AssemblyName>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <DefineConstants>RELEASE</DefineConstants>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314,40056</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.0" />
    <ProjectReference Include="../MeloongCore/MeloongCore.csproj" />
    <Reference Include="CacheCow.Client"><HintPath>lib/CacheCow.Client.dll</HintPath></Reference>
    <Reference Include="CacheCow.Client.FileStore"><HintPath>lib/CacheCow.Client.FileStore.dll</HintPath></Reference>
    <Reference Include="CacheCow.Common"><HintPath>lib/CacheCow.Common.dll</HintPath></Reference>
    <Reference Include="Imazen.WebP"><HintPath>lib/Imazen.WebP.dll</HintPath></Reference>
    <Reference Include="System.Net.Http.Formatting"><HintPath>lib/System.Net.Http.Formatting.dll</HintPath></Reference>
    <Reference Include="Ookii.Dialogs.Wpf"><HintPath>lib/Ookii.Dialogs.Wpf.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="lib/libwebp64.dll" Link="libwebp.dll" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="kernel-defaults.json" />
  </ItemGroup>
  <ItemGroup>
    <Import Include="MeloongCore" />
    <Import Include="MeloongCore.Extensions" />
    <Import Include="MeloongCore.Wpf" />
    <Import Include="MeloongCore.Wpf.Extensions" />
    <Import Include="Newtonsoft.Json.Linq" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Concurrent" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.IO" />
    <Import Include="System.IO.Compression" />
    <Import Include="System.Linq" />
    <Import Include="System.Net" />
    <Import Include="System.Net.Http" />
    <Import Include="System.Text" />
    <Import Include="System.Threading" />
    <Import Include="System.Windows" />
    <Import Include="System.Windows.Controls" />
    <Import Include="System.Windows.Data" />
    <Import Include="System.Windows.Documents" />
    <Import Include="System.Windows.Input" />
    <Import Include="System.Windows.Media" />
    <Import Include="System.Windows.Media.Imaging" />
    <Import Include="System.Xml.Linq" />
  </ItemGroup>
</Project>
